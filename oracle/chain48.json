    { "octal": "20", "name": "substitute blank", "glyph": "ƀ", "a": "‡", "h": "‡", "tag": "[verified]", "why": "prints the RECORD-MARK slug, not white space — chain-independent, the record mark is on both 48-character sets (charset.md §5; A22-0526-3 p.6 footnotes)" },
    { "octal": "72", "name": "plus zero", "glyph": "?", "a": "&", "h": "+", "tag": "[verified] on A, [likely] on H", "why": "prints the 12-zone (BA) slug. A22-0526-3 Figure 2's footnote is written for the typical — A2 — chain; on an H arrangement that slug is `+` by GA24-3073 p.27's dualing of & with +. charset.md §5.1 corrects the finder's chart, which printed `&` for both." },
    { "octal": "52", "name": "minus zero", "glyph": "!", "a": "-", "h": "-", "tag": "[verified]", "why": "prints the 11-zone slug `-` — chain-independent, `-` is on both sets (charset.md §5.1)" }
